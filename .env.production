# Production Firebase web app config (Family HQ).
#
# Loaded by Vite when the build runs in default mode (`vite build`), which is
# also the mode the production Hosting deploy uses. The authed e2e suite uses
# `vite build --mode emulator` instead, so this file does NOT affect emulator
# runs — those continue to read .env.emulator.
#
# All values below are PUBLIC identifiers and safe to commit:
#   - The Firebase web "apiKey" is documented by Google as a public identifier
#     and NOT a secret. See:
#     https://firebase.google.com/docs/projects/api-keys#general-info-api-keys
#   - The app's actual security model is firestore.rules + Firebase Auth + the
#     Hosting security headers in firebase.json, NOT the API key.
#
# If a value rotates (project deleted + recreated, etc.), just edit this file
# and open a PR — the same review path catches anything that shouldn't change.
#
# Service-account credentials for the GitHub Deploy workflow live in the
# GitHub repo's Actions secrets (FIREBASE_SERVICE_ACCOUNT) and are NEVER in
# this file.

VITE_FIREBASE_API_KEY=AIzaSyD2DCQsrXr7pAatcQIwj023WBcBzZeexUY
VITE_FIREBASE_AUTH_DOMAIN=familyhq-68638.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=familyhq-68638
VITE_FIREBASE_STORAGE_BUCKET=familyhq-68638.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=490338495018
VITE_FIREBASE_APP_ID=1:490338495018:web:135973c88614ff12efb153

# PR C / PR D — push notifications. Both values below are PUBLIC identifiers,
# same threat model as VITE_FIREBASE_API_KEY above (Google documents reCAPTCHA
# site keys as public; see https://cloud.google.com/recaptcha/docs/keys).
# Setting VITE_FCM_ENABLED=true at build time turns the SPA's lazy FCM init +
# App Check token registration on; setting it to anything else (or unset)
# keeps the FCM bundle out of the AuthedApp shell.
VITE_FCM_ENABLED=true
VITE_RECAPTCHA_SITE_KEY=6Le08BgtAAAAAJyXrGtKT4nyYZYOaEVuCO0LO3xD

# FCM Web Push public VAPID key. Generated in Firebase Console →
# Project Settings → Cloud Messaging → Web push certificates → Generate
# key pair. The public half is, by definition, public — Google publishes
# it as the identifier the browser uses to encrypt push payloads. The
# corresponding PRIVATE half stays inside Firebase and is never exposed
# to the client. Required for `getToken()` to succeed in the client; if
# unset the SPA silently degrades (no token registered, no push delivered).
# Production deploys also source this from the FIREBASE_VAPID_KEY GH
# secret (see .github/workflows/deploy.yml) so a rotated key only needs
# to be updated in one place.
VITE_FCM_VAPID_KEY=

# Analytics is auto-enabled in the Firebase console (measurementId below) but
# the app code does NOT import firebase/analytics and does NOT call
# getAnalytics() anywhere. So zero analytics traffic is emitted from the app
# itself. If we later wire analytics in, it must be consent-gated (see
# .context/constraints.md privacy posture). The measurementId is recorded
# here for completeness — flipping analytics ON later will not need a config
# change, just app code + a consent flow.
VITE_FIREBASE_MEASUREMENT_ID=G-6YY5XHQMR9

# Managed (email-less) child accounts — docs/specs/managed-child-accounts.md.
# Strict-equality client UX gate (only the literal 'true' enables): shows the
# "Kid sign-in" login mode, the Family-Management "Add a child" flow, and the
# per-child "Reset password" action. The createManagedChild /
# resetManagedChildPassword callables enforce App Check + parent authorization
# server-side regardless of this flag — flipping it off again hides the UI but
# is not a security control. Requires those two functions to be DEPLOYED
# (deploy_functions=true) before this is turned on.
VITE_MANAGED_CHILD_ENABLED=true

# Emulator is OFF in production builds. The authed e2e build sets this to
# 'true' via .env.emulator.
VITE_USE_EMULATOR=false
