# Environment variables for Family HQ
#
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored and must NEVER be committed.
#
# All values below are PLACEHOLDERS documenting the SHAPE only.
#
# NOTE: Firebase "web app" config keys (apiKey, appId, etc.) are PUBLIC
# identifiers — they are shipped in the client bundle and are NOT secrets.
# They are still injected via VITE_ env vars (per spec) so no real project
# value is hardcoded in source. Real access control lives in firestore.rules,
# not in these keys.

# --- Firebase web app config (public identifiers) ---
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# --- Local development ---
# Set to "true" to connect Auth + Firestore to the local emulator suite
# (firebase emulators:start). Leave unset/false to hit the real project.
VITE_USE_EMULATOR=true

# --- Push notifications (FCM Web) ---
# Toggle the FCM bundle + App Check init at SPA boot. Leave unset/false
# while the project stays on the Spark tier (notify-callables won't deploy).
VITE_FCM_ENABLED=

# reCAPTCHA Enterprise site key for App Check. Public identifier.
# Generated in Google Cloud Console → reCAPTCHA Enterprise.
VITE_RECAPTCHA_SITE_KEY=

# FCM Web Push public VAPID key. Generated in Firebase Console →
# Project Settings → Cloud Messaging → Web push certificates → Generate
# key pair. PUBLIC half only — the private half stays in Firebase. Without
# this `getToken()` silently returns null and no device is ever registered.
VITE_FCM_VAPID_KEY=
