# Build-time env for the authed e2e suite. Used by `npm run e2e:authed`
# via `vite build --mode emulator`.
#
# The Firebase web SDK is strict about config shape — it errors at
# initializeApp() if apiKey is missing — so this file ships REAL placeholder
# values that satisfy the shape but DO NOT correspond to a real project.
# The actual auth + firestore traffic is redirected to the local emulators
# by VITE_USE_EMULATOR=true at runtime.
#
# Safe to commit. None of these values are credentials; the apiKey field
# in Firebase web config is a public identifier, and our connectAuth/
# FirestoreEmulator hooks override the network endpoints regardless of
# what's in here.

VITE_USE_EMULATOR=true
VITE_FIREBASE_API_KEY=fake-api-key-for-emulator
VITE_FIREBASE_AUTH_DOMAIN=demo-familyhq.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-familyhq
VITE_FIREBASE_STORAGE_BUCKET=demo-familyhq.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
